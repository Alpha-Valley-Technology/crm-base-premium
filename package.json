{
  "name": "comunidade-ninja-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "emu": "firebase emulators:start",
    "serve": "firebase emulators:start --only hosting,auth,firestore,functions,storage",
    "docker:subir": "docker compose -f .docker/compose.yml up --build",
    "docker:derrubar": "docker compose -f .docker/compose.yml --profile testes down",
    "docker:logs": "docker compose -f .docker/compose.yml logs -f emuladores",
    "docker:testar": "docker compose -f .docker/compose.yml run --rm testes",
    "docker:zerar": "docker compose -f .docker/compose.yml --profile testes down --volumes",
    "portao": "node scripts/portao-de-deploy.mjs",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:medida": "node --test \"test/medida/*.test.js\"",
    "test": "firebase emulators:exec --project demo-comunidade-ninja --only firestore,storage \"node --test test/rules/**/*.test.js\"",
    "test:tudo": "npm run test:unit && npm run test:medida && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "build": "npm run format:check && npm run lint && npm run test:unit",
    "audit": "npm audit --audit-level=moderate && npm --prefix functions audit --audit-level=moderate",
    "audit:fix": "npm audit fix && npm --prefix functions audit fix",
    "clean": "rimraf node_modules package-lock.json functions/node_modules functions/package-lock.json",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.0"
  },
  "overrides": {
    "@opentelemetry/core": "^2.11.0",
    "brace-expansion": "^5.0.9",
    "fast-uri": "^4.1.4",
    "js-yaml": "^5.4.1",
    "qs": "^6.16.0",
    "stream-json": "^1.7.3",
    "tar": "^7.5.22",
    "uuid": "^14.0.2"
  },
  "license": "UNLICENSED",
  "author": "Sitacio Ossaka"
}
